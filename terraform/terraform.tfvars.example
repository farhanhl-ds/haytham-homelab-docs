# Copy to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit real secrets.

pve_endpoint = "https://192.168.100.2:8006/"
pve_api_token = "terraform@pve!terraform=<secret-uuid>"
ssh_public_key_path = "C:/Users/<you>/.ssh/id_ed25519.pub"
ct_root_password = "<generate with: openssl rand -base64 24>"
